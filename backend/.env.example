# Copy this file to backend/.env and fill in your key.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Leave empty initially. Use /api/models to select an exact model ID
# returned by your Nebius Token Factory account.
NEBIUS_MODEL=
# Optional: enables documentation, bug, CVE and advisory research
TAVILY_API_KEY=
AETHERCODE_DATA_DIR=./data
MAX_UPLOAD_MB=25
MAX_FILES=500
MAX_FILE_BYTES=200000
MAX_CONTEXT_CHARS=80000
MAX_AGENT_RETRIES=2
SANDBOX_IMAGE=python:3.12-slim
